# ─────────────────────────────────────────────────────────────
#  Real-Time Event Seat Booking System — environment template
#  Copy to .env and fill in. Docker Compose injects its own values
#  per-container (service hostnames instead of localhost).
# ─────────────────────────────────────────────────────────────

# ─── Node / API ───
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed by CORS (the Vite dev server)
CLIENT_URL=http://localhost:5173
JWT_SECRET=change_me_to_a_long_random_string_in_production
# Access tokens are short-lived; sessions persist via rotating refresh tokens
# stored in an httpOnly cookie (path=/api/auth).
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Set true when serving over HTTPS so the refresh cookie gets the Secure flag.
COOKIE_SECURE=false

# ─── PostgreSQL: primary = writes, replica = reads ───
PG_PRIMARY_HOST=localhost
PG_PRIMARY_PORT=5432
PG_REPLICA_HOST=localhost
PG_REPLICA_PORT=5433
PG_DATABASE=booking
PG_USER=booking
PG_PASSWORD=booking_pass
# Streaming-replication role (consumed by docker-compose to set up the replica)
PG_REPLICATION_USER=replicator
PG_REPLICATION_PASSWORD=replicator_pass

# ─── Redis (pub/sub + cache + queues) ───
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ─── Business rules (events vertical) ───
HOLD_TTL_SECONDS=480            # 8 minutes
RATE_LIMIT_HOLDS=3             # max holds per user per window
RATE_LIMIT_WINDOW_SECONDS=60
SESSION_TTL_SECONDS=3600

# ─── Campus bus vertical ───
# Lifecycle windows in seconds (defaults: open T-60m, confirm T-20m, sweep T-10m).
# Shrink these in tests to run a full open→confirm→release→depart cycle quickly.
BUS_OPEN_SECONDS=3600
BUS_CONFIRM_SECONDS=1200
BUS_AUTORELEASE_SECONDS=600
BUS_DEFAULT_CAPACITY=40
BUS_EMAIL_DOMAIN=lnmiit.ac.in
TZ=Asia/Kolkata

# ─── AI: Google Gemini (free tier) ───
# Get a free key (no card) at https://aistudio.google.com/apikey
# Leave blank to use the deterministic heuristic recommender fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# ─── Email (Nodemailer) ───
# Leave SMTP_* blank to auto-create an Ethereal test inbox (preview URLs are logged).
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Event Booking <no-reply@booking.local>"

# ─── Frontend (Vite) — place these in frontend/.env for production builds ───
# In dev the Vite proxy forwards /api and /ws to nginx, so these can stay default.
VITE_API_BASE=/api
VITE_WS_PATH=/ws

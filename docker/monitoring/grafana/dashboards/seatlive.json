{
  "uid": "seatlive-ops",
  "title": "SeatLive — Platform Ops",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate by route (req/s)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(http_request_duration_seconds_count[1m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p95 latency by route (s)",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Holds vs confirms (events vertical)",
      "gridPos": { "x": 0, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum(rate(seat_holds_total[5m]))", "legendFormat": "holds/s" },
        { "refId": "B", "expr": "sum(rate(seat_confirms_total[5m]))", "legendFormat": "confirms/s" }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Bus actions",
      "gridPos": { "x": 8, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (action) (rate(bus_bookings_total[5m]))",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Waitlist promotions",
      "gridPos": { "x": 16, "y": 8, "w": 8, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (vertical) (increase(waitlist_promotions_total[5m]))",
          "legendFormat": "{{vertical}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "BullMQ queue depth",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (queue, state) (bullmq_jobs)",
          "legendFormat": "{{queue}}/{{state}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Connected sockets",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "sum(socketio_connected)" }]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Process memory (RSS)",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}

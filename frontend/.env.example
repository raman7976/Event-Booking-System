# Frontend build-time config (Vite). Copy to .env.local for local overrides.
#
# Leave EMPTY for local dev — the Vite dev server proxies /api and /ws to nginx,
# so everything is same-origin.
#
# For a split production deploy (this app on Vercel, backend on Railway), set this
# to the backend's public origin — NO trailing slash, NO /api suffix:
#   VITE_API_URL=https://your-backend.up.railway.app
VITE_API_URL=
